From 8f9bcd0f7bb55b6280b7dcc385b43fdbdd95a0f1 Mon Sep 17 00:00:00 2001
From: Nectura <45967738+Nectura@users.noreply.github.com>
Date: Fri, 25 Sep 2026 00:34:33 +0300
Subject: [PATCH 2/2] fix(server): push the response caps on a re-discovered
 editor channel

rediscoverEditor built its replacement channel with an auth callback
that recorded the version but never called sendLimitsIfConfigured, so
after an editor-port swap the plugin kept its own ProjectSettings caps
instead of the server's (GODOT_MCP_SCRIPT_READ_LIMIT /
GODOT_MCP_WS_BUFFER_LIMIT or the defaults). Both channel sites now go
through one openEditorChannel factory.
---
 src/transport/bridge.ts             | 36 ++++++++++-----------
 test/unit/bridge-rediscover.test.ts | 49 +++++++++++++++++++++++++++--
 2 files changed, 63 insertions(+), 22 deletions(-)

diff --git a/src/transport/bridge.ts b/src/transport/bridge.ts
index 8664a55..5d178eb 100644
--- a/src/transport/bridge.ts
+++ b/src/transport/bridge.ts
@@ -121,16 +121,22 @@ export function createBridge(
   }
 
   const getNotificationHandler = () => notificationHandler;
-  let editor = createChannel(
-    editorUrl,
-    projectPath,
-    ({ version, headless: h }) => {
-      setGodotVersion(version);
-      headless = h;
-      sendLimitsIfConfigured(editor);
-    },
-    getNotificationHandler,
-  );
+  // Every editor channel — the startup one and any re-discovery swaps in —
+  // records the version and pushes the response caps once it authenticates.
+  function openEditorChannel(url: string): Channel {
+    const channel = createChannel(
+      url,
+      projectPath,
+      ({ version, headless: h }) => {
+        setGodotVersion(version);
+        headless = h;
+        sendLimitsIfConfigured(channel);
+      },
+      getNotificationHandler,
+    );
+    return channel;
+  }
+  let editor = openEditorChannel(editorUrl);
   let cachedEditorPort = Number(new URL(editorUrl).port);
 
   // ── Editor-port re-discovery ─────────────────────────────────────
@@ -159,15 +165,7 @@ export function createBridge(
     const oldPort = cachedEditorPort;
     cachedEditorPort = port;
     await editor.close();
-    editor = createChannel(
-      `ws://127.0.0.1:${cachedEditorPort}`,
-      projectPath,
-      ({ version, headless: h }) => {
-        setGodotVersion(version);
-        headless = h;
-      },
-      getNotificationHandler,
-    );
+    editor = openEditorChannel(`ws://127.0.0.1:${cachedEditorPort}`);
     process.stderr.write(`[bridge] editor port changed ${oldPort} → ${cachedEditorPort}\n`);
     return true;
   }
