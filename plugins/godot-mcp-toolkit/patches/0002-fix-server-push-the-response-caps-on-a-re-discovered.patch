+// ── Case 8: the swapped-in channel pushes the response caps ──────────
+
+async function testSwapPushesResponseCaps() {
+  if (!REDIRECT) {
+    console.log("  SKIP (darwin: no registry path override): limits after swap");
+    return;
+  }
+  const projectPath = "/__godot_mcp_unit_test__/rediscover-limits";
+  const serverNew = await makeMockServer();
+  const portOld = await getDeadPort();
+  writeRegistry({ [normalizePath(projectPath)]: makeEntry({ port: serverNew.port }) });
+  const bridge = createBridge(`ws://127.0.0.1:${portOld}`, {
+    projectPath,
+    scriptReadLimitBytes: 512 * 1024,
+    wsBufferLimitBytes: 2048 * 1024,
+  });
+
+  try {
+    await bridge.call("echo", { ping: 1 }, 5000);
+    // meta.set_limits is fire-and-forget after auth; give it a moment to land.
+    for (let i = 0; i < 20 && !serverNew.methods().includes("meta.set_limits"); i++) {
+      await new Promise((r) => setTimeout(r, 50));
+    }
+    assert.ok(
+      serverNew.methods().includes("meta.set_limits"),
+      `the swapped-in editor received meta.set_limits (got ${JSON.stringify(serverNew.methods())})`,
+    );
+    console.log("  PASS: the channel swapped in by re-discovery pushes the response caps after auth");
+  } finally {
+    await bridge.close();
+    await serverNew.close();
+  }
+}
+
 // ── Main ─────────────────────────────────────────────────────────────
 
 async function main() {
@@ -401,7 +443,8 @@ async function main() {
   await testTtlGuardBlocksSecondRediscover();
   await testStandInEntryIsNotAdopted();
   await testAuthFailureSwapsToRegisteredEditor();
-  console.log("All 7 bridge-rediscover tests passed.");
+  await testSwapPushesResponseCaps();
+  console.log("All 8 bridge-rediscover tests passed.");
 }
 
