 }
 
+// ── Case 6: a runtime-only stand-in entry is never adopted ───────────
+
+async function testStandInEntryIsNotAdopted() {
+  if (!REDIRECT) {
+    console.log("  SKIP (darwin: no registry path override): stand-in entry");
+    return;
+  }
+  const projectPath = "/__godot_mcp_unit_test__/rediscover-stand-in";
+  const serverNew = await makeMockServer();
+  const portOld = await getDeadPort();
+  // A playtest started with no editor open: the toolkit's runtime self-heal
+  // writes an entry with port -1 and no token path.
+  writeRegistry({
+    [normalizePath(projectPath)]: makeEntry({ port: -1, token_path: "", runtime_port: 6571 }),
+  });
+  const bridge = createBridge(`ws://127.0.0.1:${portOld}`, { projectPath });
+  // Date only: the re-discovery TTL reads Date.now(); sockets keep real timers.
+  const clock = FakeTimers.install({ toFake: ["Date"], now: Date.now() });
+
+  try {
+    // Adopting port -1 would build ws://127.0.0.1:-1, whose TypeError is no
+    // BridgeError, so no later failure would ever re-read the registry.
+    await assert.rejects(
+      bridge.call("echo", {}, 5000),
+      (err: unknown) => err instanceof BridgeError && err.code === "CONNECT_FAILED",
+      "stand-in entry → no swap; the dead port's CONNECT_FAILED propagates",
+    );
+    // The editor opens and registers its real port. The next call past the TTL
+    // finds it without a reconnect.
+    writeRegistry({ [normalizePath(projectPath)]: makeEntry({ port: serverNew.port }) });
+    clock.tick(5_001);
+    const r = await bridge.call("echo", { ping: 1 }, 5000);
+    assert.deepEqual(r, { ok: true }, "the call resolves against the editor that registered later");
+    assert.equal(serverNew.authCount(), 1, "the retry reached the newly registered editor");
+    console.log("  PASS: a port -1 stand-in is never adopted, and a later editor is found without a reconnect");
+  } finally {
+    clock.uninstall();
+    await bridge.close();
+    await serverNew.close();
+  }
+}
+
+// ── Case 7: an auth failure on the cached port swaps to the registry's ──
+
+async function testAuthFailureSwapsToRegisteredEditor() {
+  if (!REDIRECT) {
+    console.log("  SKIP (darwin: no registry path override): auth-failure swap");
+    return;
+  }
+  const projectPath = "/__godot_mcp_unit_test__/rediscover-auth";
+  const serverNew = await makeMockServer();
+  const foreign = await makeForeignServer();
+  // The bridge started on the default port, where another project's editor
+  // answers; this project's editor is registered on a different port.
+  writeRegistry({ [normalizePath(projectPath)]: makeEntry({ port: serverNew.port }) });
+  const bridge = createBridge(`ws://127.0.0.1:${foreign.port}`, { projectPath });
+
+  try {
+    const r = await bridge.call("echo", { ping: 1 }, 5000);
+    assert.deepEqual(r, { ok: true }, "the call resolves against the registered editor after the swap");
+    assert.equal(serverNew.authCount(), 1, "the retry reached the registered editor, not the foreign one");
+    console.log("  PASS: an auth failure on a foreign editor swaps to the registered port and the retry resolves");
+  } finally {
+    await bridge.close();
+    await serverNew.close();
+    await foreign.close();
+  }
+}
+
