+/**
+ * The editor WebSocket port an entry advertises, or null when it names no
+ * dialable editor. A playtest launched with no editor open self-heals a
+ * runtime-only entry with `port: -1`; dialing that as an editor port fails
+ * with ERR_INVALID_URL, so every editor-port reader goes through this gate.
+ */
+export function editorPortOf(entry: RegistryEntry): number | null {
+  const port = entry.port;
+  return Number.isInteger(port) && port >= 1 && port <= 65535 ? port : null;
