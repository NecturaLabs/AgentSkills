+/**
+ * A foreign editor: accepts the connection but closes it on the first message
+ * instead of answering the auth handshake — another project's editor on the
+ * port this bridge cached. The bridge surfaces it as AUTH_FAILED.
+ */
+function makeForeignServer(): Promise<MockServer> {
+  return new Promise((resolve) => {
+    const wss = new WebSocketServer({ port: 0, host: "127.0.0.1" });
+    const sockets = new Set<WS>();
+    wss.on("listening", () => {
+      resolve({
+        port: (wss.address() as AddressInfo).port,
+        authCount: () => 0,
+        close: () =>
+          new Promise<void>((res) => {
+            for (const s of sockets) s.terminate();
+            wss.close(() => res());
+          }),
+      });
+    });
+    wss.on("connection", (sock) => {
+      sockets.add(sock);
+      sock.on("close", () => sockets.delete(sock));
+      sock.on("message", () => sock.close(1000, "not this project's editor"));
+    });
+  });
+}
+
 // ── Case 1: a port change swaps the channel and the retry resolves ───
 
