+  const deadPin = await getDeadPort();
+  // A playtest with no editor open: the toolkit's runtime self-heal entry.
+  writeRegistry({
+    [normalizePath(projectPath)]: makeEntry({ port: -1, token_path: "", runtime_port: 6571 }),
+  });
