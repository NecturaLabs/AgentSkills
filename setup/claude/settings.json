{
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "switchModelsOnFlag": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent-model-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-check.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "askUserQuestionTimeout": "60s",
  "tui": "fullscreen",
  "timeFormat": "12-hour",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoScrollEnabled": true,
  "extraKnownMarketplaces": {
    "necturalabs": {
      "source": {
        "source": "github",
        "repo": "NecturaLabs/AgentSkills"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      },
      "autoUpdate": true
    },
    "scenario-skills": {
      "source": {
        "source": "github",
        "repo": "scenario-labs/skills"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "necturalabs@necturalabs": true,
    "security-audit@necturalabs": true,
    "superpowers@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "frontend-design@claude-plugins-official": true,
    "web-design-guidelines@necturalabs": true,
    "vercel@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "remotion@necturalabs": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "agent-browser@agent-browser": true,
    "blender-lab-mcp@necturalabs": true,
    "godot-mcp-toolkit@necturalabs": true,
    "typescript-native-lsp@necturalabs": true,
    "lua-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "sentry-cli@claude-plugins-official": true,
    "meshy-mcp@necturalabs": true,
    "01.-getting-started@scenario-skills": true,
    "03.-images@scenario-skills": true,
    "04.-game-art-and-environments@scenario-skills": true,
    "05.-video-and-audio@scenario-skills": true,
    "06.-consistency-and-custom-models@scenario-skills": true,
    "07.-reviewing-and-organizing-output@scenario-skills": true
  },
  "disabledMcpServers": [
    "plugin:vercel:vercel"
  ]
}
