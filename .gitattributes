# Auto detect text files and normalize line endings
* text=auto

# Markdown
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
hooks/session-start text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Polyglot hook wrapper: must be LF for the embedded bash portion to parse
# (CRLF breaks the heredoc terminator and shell built-ins). Modern cmd.exe
# tolerates LF-only line endings, so the Windows path still works.
hooks/run-hook.cmd text eol=lf

# Text data files
*.txt text eol=lf

# JSON/YAML
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf

# Python
*.py text eol=lf
